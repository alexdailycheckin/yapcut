#!/usr/bin/env bash
# YapCut privacy gate. Refuses, never warns, same stance as prose-gate.
#
# This repo is PUBLIC. Since 2026-09-09 the live install CONSUMES the installed plugin
# (the workspace's engine/ symlink points at the plugin cache), so private config and
# data live outside this tree. The gate still refuses private paths and strings because
# prose has no .gitignore: two leaks reached the public remote before it existed
# (CHANGELOG 3.4.4, 3.4.5). Modes: no argument = staged diff (the commit hook);
# --history = scan every reachable commit (release.sh runs it).
#
# Install once per clone:  git config core.hooksPath .githooks

set -euo pipefail
MODE="${1:-}"

fail() { echo "PRE-COMMIT GATE: $1" >&2; exit 1; }

STAGED=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$STAGED" ] && [ "$MODE" != "--history" ] && exit 0

# 1. Private files must never be staged, even force-added.
#    weeks/*.json except the bundled example; filled configs; performance data;
#    rendered dashboards; the creator's own media.
while IFS= read -r f; do
  case "$f" in
    *"/weeks/0000-00-00-example.json") ;;
    *"/weeks/"*.json) fail "week data staged: $f (private, lives only in the workspace)" ;;
    *"/performance/"*) fail "performance data staged: $f" ;;
    *"/radar-config.json") fail "filled radar-config staged: $f (radar-config.example.json ships instead)" ;;
    *"/brand-config.json") fail "filled brand-config staged: $f (brand-config.example.json ships instead)" ;;
    *"/dashboard.html") fail "rendered dashboard staged: $f" ;;
    *"/assets/"*) fail "creator media staged: $f (the sfx pack is generated, beds are personal)" ;;
    *".bak"*|*".pre-symlink"*) fail "backup file staged: $f" ;;
  esac
done <<< "$STAGED"

# 2. Private strings must never appear in staged CONTENT.
#
# This denylist has two halves. The STRUCTURAL half is below in plaintext: it
# names shapes, not people, so publishing it costs nothing. The IDENTIFYING
# half (real customer names, vault filenames, the creator's machine path) is
# itself the secret, and this repo is public.
#
# Until 2026-09-09 the identifying half lived here in plaintext while the gate
# excused its own file from every scan, so the customer names it existed to
# protect were readable on the public remote, and the failure message printed
# the whole list on any trip. That half now lives in private-patterns.txt,
# gitignored, symlinked in from the private mirror. The gate REFUSES to run
# without it: a denylist that silently degrades to half its rules is worse
# than no denylist, because it still prints reassurance.
PRIV="$(dirname "$0")/private-patterns.txt"
[ -f "$PRIV" ] || fail "missing .githooks/private-patterns.txt (gitignored, never published). Symlink it in from the private mirror; refusing to run a half-blind gate."
PRIVATE_PATTERNS="$(grep -hvE '^[[:space:]]*(#|$)' "$PRIV" | paste -sd'|' - || true)"
[ -n "$PRIVATE_PATTERNS" ] || fail "private-patterns.txt holds no patterns; refusing to run a half-blind gate"

# Structural half, safe to publish: workspace paths that should never be quoted
# in tracked prose.
PATTERNS='Desktop/Claude/(Reach|outlier-radar/weeks|outlier-radar/performance)'
# Generic vault filenames. The identifying ones load from private-patterns.txt.
PATTERNS="$PATTERNS"'|(^|[^a-z-])(now|decisions|preferences)\.md'
# Reach as an actor, an owner or a seller, rather than the partner pill. The
# pill renders from PARTNER/attribution constants and never says these.
PATTERNS="$PATTERNS"'|Reach (sells|pipeline|brand|block|wordmark|customer)|Reach'"'"'s (product|own|brand)|joining Reach|at Reach\b'
# Identifying half, loaded from outside the tree.
PATTERNS="$PATTERNS|$PRIVATE_PATTERNS"
# --history: scan every reachable commit for the same patterns (the 3.4.4 scrub cleaned HEAD and
# left a customer's figures in commit 15838a7; a staged-diff gate can never see that).
if [ "$MODE" = "--history" ]; then
  HITS=$(git grep -nE "$PATTERNS" $(git rev-list --all) -- . ':(exclude).githooks/*' 2>/dev/null | head -20 || true)
  if [ -n "$HITS" ]; then
    echo "$HITS" >&2
    fail "private markers are reachable in git history ($(echo "$HITS" | wc -l | tr -d ' ') hits shown). Rewrite with git filter-repo --replace-text before releasing."
  fi
  echo "history clean"; exit 0
fi

# 3. Doc-to-code links: every python3 <name>.py / bash scripts/<name>.sh / references/<name>.md
#    token in a staged SKILL.md must exist under that plugin (four live defects on 2026-09-09:
#    scripts/segment_corpus.py named where no scripts/ dir exists, a qa value the gate rejects,
#    a never-skip library.py that did not ship, inverted lane semantics).
while IFS= read -r f; do
  case "$f" in plugins/*/skills/*/SKILL.md)
    SKILLDIR="$(dirname "$f")"
    MISSING=$(python3 - "$f" "$SKILLDIR" <<'PY'
import re, sys, os
f, d = sys.argv[1:3]; t = open(f).read(); miss = []
for m in re.finditer(r"python3\s+([A-Za-z0-9_./-]+\.py)|bash\s+([A-Za-z0-9_./-]+\.sh)|`(references/[A-Za-z0-9_.-]+\.md)`|`([a-z_]+\.py)`|`(scripts/[A-Za-z0-9_./-]+\.(?:py|sh))`", t):
    tok = next(x for x in m.groups() if x)
    tok = tok.replace("<workdir>/", "")
    cands = [os.path.join(d, tok), os.path.join(d, "scripts", os.path.basename(tok)), os.path.join(d, os.path.basename(tok)),
             os.path.join(os.path.dirname(d), "outlier-radar", tok), os.path.join(os.path.dirname(d), "lead-magnet-report", tok),
             os.path.join("plugins", "outlier-radar", "skills", "outlier-radar", tok),
             os.path.join("plugins", "outlier-radar", "skills", "lead-magnet-report", tok)]
    if not any(os.path.exists(c) for c in cands):
        miss.append(tok)
print("\n".join(sorted(set(miss))))
PY
)
    [ -z "$MISSING" ] || { echo "$MISSING" >&2; fail "$f names files that do not ship (above)"; } ;;
  esac
done <<< "$STAGED"

# The creator as an actor in tracked doctrine. This tree IS the public repo AND
# the live install, single-sourced, so prose has no .gitignore to hide behind:
# 101 references to Alex by name had accumulated in the skill files. The rule is
# that tracked doctrine names no creator; creator specifics belong in
# radar-config.json and the other gitignored files. Deliberate attribution (the
# owner/author fields, the byline, alexmuresan.com, the Reach partner pill) is
# spelled differently and is not matched. "Alex Hormozi" is a cited author, not
# the creator, so it is excused explicitly.
ALEX_HITS=$(git diff --cached -U0 -- 'plugins' \
       | grep -E "^\+" | grep -Ev "^\+\+\+" \
       | grep -Ei '\balex\b' \
       | grep -viE 'alexmuresan\.com|ALEXMURESAN|Alex Muresan|Alex Hormozi' || true)
if [ -n "$ALEX_HITS" ]; then
  echo "$ALEX_HITS" | head -5 >&2
  fail "staged plugin content names the creator; tracked doctrine must be creator-agnostic (put specifics in radar-config.json)"
fi
# The hook itself carries the patterns (that is what a denylist is), so its own
# diff is excluded from the content scan; path rules above still apply to it.
HITS=$(git diff --cached -U0 -- . ':(exclude).githooks/*' \
       | grep -E "^\+" | grep -Ev "^\+\+\+" | grep -En "$PATTERNS" || true)
if [ -n "$HITS" ]; then
  echo "$HITS" | head -5 >&2
  fail "staged content carries a private marker (matched lines above)"
fi

exit 0
